# All NEXT_PUBLIC_* values are visible in the browser and must never contain secrets.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MENU_URL=http://localhost:3002/menu
# Optional HTTPS installation/landing page. Leave empty until approved.
NEXT_PUBLIC_MOBILE_APP_URL=
# Use "demo" until a public store/installation landing page exists.
NEXT_PUBLIC_MOBILE_APP_DISTRIBUTION=demo
