# API + Prisma only. Never expose this file to Next.js or Expo.
DATABASE_URL="postgresql://postgres:replace_me@localhost:5432/terrasse_bleue?schema=public"

# API Configuration
PORT=3001
HOST=0.0.0.0
JWT_ACCESS_SECRET="replace_with_at_least_32_random_characters"
JWT_REFRESH_SECRET="replace_with_a_different_32_character_random_value"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:3002,http://localhost:19006,http://localhost:8081,http://127.0.0.1:8081"

# Environment
NODE_ENV="development"

# Optional seed-only credential. Set locally/temporarily; never commit a real value.
SEED_CUSTOMER_PASSWORD="replace_with_a_private_12_character_password"
E2E_CUSTOMER_PASSWORD="use_the_same_private_value_for_database_e2e_tests"
